# PharmaTrack Pro — frontend environment (copy to frontend/.env.local)
# Only PUBLIC values belong here: everything prefixed VITE_ is shipped to the browser.
# Never put the Supabase service-role key or the Anthropic key in this file.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Backend base URL. In development Vite proxies /api to http://localhost:5001.
VITE_API_URL=/api
