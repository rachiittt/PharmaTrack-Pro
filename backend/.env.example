# ---------------------------------------------------------------------------
# PharmaTrack Pro — backend environment
# Copy to backend/.env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=5001
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Bypasses RLS. Never put this in the frontend or in git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — enables the AI assistant and invoice OCR. Server-only.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_DAILY_LIMIT_PER_PHARMACY=200

# Used only by `npm run seed:demo` (password for the three demo logins)
DEMO_PASSWORD=
